# Infisical secret catalog (placeholder values only).
# These keys are NOT provisioned in Infisical from this repo yet — no CLI,
# token, or project ID is available on this VM. Same names should be created
# under Infisical env `dev`, folder `/datafabric-macgyver`.
#
# After `infisical login` and a real project-id in `.infisical.yaml`:
#   infisical sm secrets set --env=dev --path=/datafabric-macgyver --file=./.env
#   infisical sm export --env=dev --path=/datafabric-macgyver > .env
# Do not commit `.env`.

# ---------------------------------------------------------------------------
# Infisical connection (non-secret; fill after you create the project)
# ---------------------------------------------------------------------------
INFISICAL_PROJECT_ID=REPLACE_WITH_INFISICAL_PROJECT_ID
INFISICAL_ENVIRONMENT=dev
INFISICAL_SECRET_PATH=/datafabric-macgyver
INFISICAL_DOMAIN=

# ---------------------------------------------------------------------------
