# Infisical secret catalog (placeholder values only).
# These keys are NOT provisioned in Infisical from this repo yet — no CLI,
# token, or project ID is available on this VM. Same names should be created
# under Infisical env `dev`, folder `/datafabric-macgyver`.
#
# After `infisical login` and a real project-id in `.infisical.yaml`:
#   infisical sm secrets set --env=dev --path=/datafabric-macgyver --file=./.env
#   infisical sm export --env=dev --path=/datafabric-macgyver > .env
# Do not commit `.env`.

# ---------------------------------------------------------------------------
# Infisical connection (non-secret; fill after you create the project)
# ---------------------------------------------------------------------------
INFISICAL_PROJECT_ID=REPLACE_WITH_INFISICAL_PROJECT_ID
INFISICAL_ENVIRONMENT=dev
INFISICAL_SECRET_PATH=/datafabric-macgyver
INFISICAL_DOMAIN=

# ---------------------------------------------------------------------------
# AWS Workshop Studio (this event is browser-joined, not a SHOW pack)
# ---------------------------------------------------------------------------
WORKSHOP_STUDIO_DASHBOARD=
WORKSHOP_JOIN_URL=
WORKSHOP_JOIN_EMAIL=
WORKSHOP_EVENT_NAME=
WORKSHOP_CONTENT_TITLE=

# ---------------------------------------------------------------------------
# Required before labs — Splunk identity + Workshop Studio AWS STS
# ---------------------------------------------------------------------------

# Splunk Cloud Search & Reporting stack (https://<stack>.splunkcloud.com)
SPLUNK_CLOUD_URL=

# Splunk login used for Search & Reporting and Data Management
SPLUNK_USERNAME=
SPLUNK_PASSWORD=

# Splunk Cloud Services tenancy (Ingest Processor / pipelines)
# Lab 1 calls this "the link provided in your Splunk SHOW lab environment"
SCS_TENANCY_URL=

# SHOW portal, if it is a different host from the two URLs above
SHOW_PORTAL_URL=

# Temporary workshop AWS account. SHOW stacks typically issue STS creds.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Digits only. Use the AWS console Copy button so dashes are stripped.
AWS_ACCOUNT_ID=

# Lab guide hardcodes us-east-1. Follow the guide unless SHOW says otherwise.
AWS_REGION=us-east-1

# Lab 5 — HTTP Event Collector token for access_combined
HEC_TOKEN_ACCESS_COMBINED=

# ---------------------------------------------------------------------------
# Filled as labs run — still local only
# ---------------------------------------------------------------------------

# IAM role Lab 2 tags and trusts (splunk-fs-s3-workshop-SplunkFsS3Role-xxx)
AWS_IAM_ROLE_ARN=

# Pre-created by the workshop CloudFormation stack (this event: splunk-fs-s3-workshop)
S3_LOGS_BUCKET=
S3_WAF_BUCKET=
S3_ATHENA_OUTPUT=
S3_PARTICIPANT_ASSETS=
GLUE_DATABASE=
GLUE_TABLE_CLOUDFRONT=
SQS_QUEUE_ARN=

# Created during the lab. Lab 2 bucket MUST start with splunk-
S3_ASA_BUCKET=

# Lab 6 bucket MUST use the prefix shown in the Self Storage Locations UI
S3_DDSS_BUCKET=

# Local path to the Lab 3b EC2 key pair. Never commit the key file.
EC2_KEY_PATH=
